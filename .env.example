# ============================================================================
# PaisaTrack - Environment Variables Template (Reference Only)
# ============================================================================
# IMPORTANT: Spring Boot does NOT automatically read a .env file.
# This file is a reference template only. You must configure these environment
# variables manually in your Windows PowerShell terminal, Windows System
# Environment Variables, or VS Code Java launch configuration before running.
# Never commit real database passwords to version control.
# ============================================================================

DB_URL=jdbc:mysql://localhost:3306/paisatrack_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here
SERVER_PORT=8080
